{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-forma-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat for the MCP SDK; global_fetch_strictly_public so client metadata documents
  // (how Claude and ChatGPT identify themselves when signing in) are only fetched from the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-forma",
      // Replace with the id printed by `npx wrangler d1 create nova-forma` (see README).
      "database_id": "44650cbf-6ebc-4b0a-b18d-fdbf8ebf8550",
      "migrations_dir": "migrations"
    }
  ],
  // Stores OAuth clients, grants and (hashed) tokens for MCP sign-in.
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace with the id printed by `npx wrangler kv namespace create OAUTH_KV` (see README).
      "id": "c412c3e4ac284882875d2aaa2b1407e1"
    }
  ]
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   SYNC_TOKEN - the bearer token the app sends to /v1/sync, and the password for MCP sign-in
}
