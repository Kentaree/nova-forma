{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-forma-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-forma",
      // Replace with the id printed by `npx wrangler d1 create nova-forma` (see README).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   SYNC_TOKEN - the bearer token the app sends to /v1/sync
}
